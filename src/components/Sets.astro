---
const videos = [
  { id: 'vA7mb2R0nRg', label: 'SSL' },
  { id: 'iASquIZDFc4', label: 'HERMETIK' },
];
---

<section class="relative overflow-hidden px-6 py-24 md:px-12 md:py-32 lg:py-40">
  <img
    src="/img/mic-01.png"
    alt=""
    aria-hidden="true"
    loading="lazy"
    class="pointer-events-none absolute -right-12 top-16 -z-0 w-64 brightness-0 invert opacity-[0.06] md:-right-20 md:top-24 md:w-[28rem]"
  />

  <p
    class="relative text-xs font-bold uppercase tracking-[0.3em] text-white/50"
  >
    05 — Sets
  </p>
  <h2
    class="relative mt-4 font-serif text-4xl md:text-5xl lg:text-6xl leading-tight"
  >
    En vivo,<br />en cabina.
  </h2>

  <div
    class="relative mt-16 grid grid-cols-1 gap-10 md:mt-24 md:grid-cols-2 md:gap-6"
  >
    {
      videos.map((v, i) => (
        <figure>
          <div class="aspect-video overflow-hidden bg-black ring-1 ring-white/10">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${v.id}`}
              title={`Video set x ${v.label}`}
              class="h-full w-full"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            />
          </div>
          <figcaption class="mt-4 flex items-baseline gap-4">
            <span class="text-xs font-bold uppercase tracking-[0.3em] text-white/40">
              Set 0{i + 1}
            </span>
            <span class="font-serif text-xl md:text-2xl">x {v.label}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
