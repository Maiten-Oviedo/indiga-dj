---
import { Image } from 'astro:assets';
import hero from '../assets/img/hero.jpg';
import heroCutout from '../assets/img/hero-no-back.png';
---

<section id="hero-section" class="relative min-h-dvh overflow-hidden">
  <!-- Fondo: en mobile normal, en desktop muy oscurecido -->
  <Image
    id="hero-bg"
    src={hero}
    alt=""
    class="absolute inset-0 h-full w-full object-cover object-[center_25%] md:opacity-25"
    loading="eager"
    widths={[640, 1024, 1600, 2400]}
    sizes="100vw"
  />

  <!-- Overlay mobile (original) -->
  <div
    class="absolute inset-0 md:hidden"
    style="background: linear-gradient(180deg, rgba(8,8,15,0.45) 0%, rgba(8,8,15,0.15) 35%, rgba(8,8,15,0.85) 100%);"
  ></div>

  <!-- Overlay desktop (más oscuro para que resalte el texto) -->
  <div
    class="absolute inset-0 hidden md:block"
    style="background: linear-gradient(180deg, #08080f 0%, rgba(8,8,15,0.2) 45%, rgba(8,8,15,0.85) 100%);"
  ></div>

  <!--
    Halo: la luz índigo de la foto, viva. Tres capas, un dueño cada una:
    #hero-halo (scroll, GSAP) > .halo-breath (respira, CSS) > #hero-halo-beat (kick, JS).
    Posición: sobre el foco de la foto en mobile; detrás de la cabeza del recorte en desktop.
  -->
  <div
    id="hero-halo"
    aria-hidden="true"
    class="pointer-events-none absolute left-[65%] top-[22%] z-[5] aspect-square w-[120vw] -translate-x-1/2 -translate-y-1/2 mix-blend-screen md:left-[54%] md:top-[36%] md:w-[70vw]"
  >
    <div class="halo-breath absolute inset-0">
      <div
        id="hero-halo-beat"
        class="absolute inset-0 rounded-full"
        style="background: radial-gradient(circle, rgba(199,210,254,0.42) 0%, rgba(129,140,248,0.2) 30%, rgba(79,70,229,0.07) 55%, transparent 70%);"
      >
      </div>
    </div>
    <!-- Humo: dos manchas de luz difusa que derivan lento -->
    <div
      class="haze absolute left-[10%] top-[30%] h-1/2 w-3/5 rounded-full opacity-60 blur-3xl"
      style="background: radial-gradient(circle, rgba(199,210,254,0.18), transparent 70%);"
    >
    </div>
    <div
      class="haze haze-alt absolute right-[5%] top-[15%] h-2/5 w-1/2 rounded-full opacity-50 blur-3xl"
      style="background: radial-gradient(circle, rgba(165,180,252,0.16), transparent 70%);"
    >
    </div>
  </div>

  <!-- Header: tagline izq + (mobile: h1 / desktop: presskit) der -->
  <header class="absolute inset-x-0 top-0 z-30 flex items-start justify-between p-6 md:p-12">
    <p
      data-anim="hero"
      class="text-xs font-bold uppercase leading-tight tracking-tight md:text-sm"
    >
      Feel what I<br />hear.
    </p>

    <!-- Mobile: h1 top-right -->
    <h1
      data-anim="hero"
      class="font-serif text-5xl font-bold leading-none tracking-tight md:hidden"
    >
      INDIGA
    </h1>

    <!-- Desktop: Presskit top-right -->
    <p
      data-anim="hero"
      class="hidden text-right text-[10px] font-bold uppercase tracking-[0.2em] md:block md:text-xs"
    >
      Presskit<br />2026
    </p>
  </header>

  <!-- Desktop only: INDIGA centrado detrás del recorte (z-10) -->
  <div
    id="hero-word"
    class="pointer-events-none absolute inset-0 z-10 hidden select-none md:flex md:items-start md:justify-center md:pt-[18vh]"
    aria-hidden="true"
  >
    <span
      data-anim="hero"
      class="font-serif font-bold leading-none tracking-tight text-white whitespace-nowrap"
      style="font-size: clamp(4rem, 20vw, 20rem);"
    >
      INDIGA
    </span>
  </div>

  <!-- Desktop only: recorte de Cele encima del texto (z-20) -->
  <div id="hero-cutout" class="absolute inset-x-0 bottom-[-10%] z-20 hidden md:flex md:justify-center">
    <Image
      src={heroCutout}
      alt="INDIGA DJ"
      class="h-auto max-h-[95vh] w-auto"
      loading="eager"
      widths={[640, 900, 1200]}
      sizes="60vw"
    />
  </div>

  <!-- Mobile only: Presskit bottom-left -->
  <footer
    data-anim="hero"
    class="absolute bottom-0 left-0 z-30 p-6 text-left text-[10px] font-bold uppercase tracking-[0.2em] md:hidden"
  >
    Presskit<br />2026
  </footer>
</section>

<style>
  /* La luz respira: ciclo lento, independiente del scroll y del kick */
  .halo-breath {
    animation: halo-breathe 7s ease-in-out infinite;
  }
  @keyframes halo-breathe {
    0%,
    100% {
      transform: scale(0.92);
      opacity: 0.7;
    }
    50% {
      transform: scale(1.08);
      opacity: 1;
    }
  }
  .haze {
    animation: haze-drift 18s ease-in-out infinite alternate;
  }
  .haze-alt {
    animation-duration: 23s;
    animation-direction: alternate-reverse;
  }
  @keyframes haze-drift {
    from {
      transform: translate(-8%, 4%);
    }
    to {
      transform: translate(8%, -5%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .halo-breath,
    .haze {
      animation: none;
    }
  }
</style>
