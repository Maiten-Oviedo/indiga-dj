---
import { Image } from 'astro:assets';
import portrait from '../assets/img/portrait-02.jpg';
import { bio } from '../data/presskit';
---

<section class="relative grid min-h-dvh grid-cols-1 overflow-hidden md:grid-cols-2">
  <div class="relative order-2 min-h-[60vh] md:order-1 md:min-h-dvh">
    <Image
      src={portrait}
      alt="INDIGA"
      class="absolute inset-0 h-full w-full object-cover"
      widths={[640, 1024, 1600]}
      sizes="(min-width: 768px) 50vw, 100vw"
      loading="lazy"
    />
  </div>
  <div
    class="relative order-1 flex flex-col justify-center gap-8 p-8 md:order-2 md:p-16 lg:p-24"
  >
    <p class="text-xs font-bold uppercase tracking-[0.3em] text-white/50">
      02 — Bio
    </p>
    <h2 class="font-serif text-4xl md:text-5xl lg:text-6xl leading-tight">
      Una narrativa<br />en evolución.
    </h2>
    <div data-reveal class="flex flex-col gap-8">
      {bio.map((p) => (
        <p class="max-w-md text-base md:text-lg leading-relaxed text-white">
          {p.split(' ').map((w) => <span class="reveal-word">{w} </span>)}
        </p>
      ))}
    </div>
  </div>
</section>
