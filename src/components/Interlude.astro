---
// Interlude "Fusión": la mirada entra en foco con el scroll (A) y la señal (B)
// corre por debajo. El puente: con música sonando, la mirada late con cada kick a 142 BPM
// — "Feel what I hear" literal.
// ponytail: el pulso va al tempo, no al audio real — SoundCloud no expone el audio (CORS).
import { Image } from 'astro:assets'
import portraitEyes from '../assets/img/portrait-eyes.jpg'

// Foto 3867×1176, ojos al 75% de su alto: capa al 130% y subida 47.5% → ojos al centro.
// Horizontal: ojo derecho en mobile (51%), ambos ojos en desktop (33%).
const img = 'absolute left-0 top-[-47.5%] h-[130%] w-full object-cover object-[51%_50%] md:object-[33%_50%]'
---

<section id="fusion" data-no-fade class="relative h-svh overflow-hidden md:h-[115svh]">
  <!-- Escala por scroll (GSAP) -->
  <div
    id="fusion-layers"
    class="absolute inset-0 will-change-transform"
    style="mask-image: linear-gradient(180deg, #000 62%, transparent 84%);"
  >
    <!-- Latido por kick (JS por frame): elemento aparte para no pisar a GSAP -->
    <div id="fusion-beat" class="absolute inset-0 will-change-transform">
      <Image src={portraitEyes} alt="" class={`${img} blur-[18px]`} widths={[800]} sizes="100vw" loading="lazy" />
      <Image
        id="fusion-sharp"
        src={portraitEyes}
        alt="Mirada de INDIGA"
        class={`${img} opacity-0`}
        widths={[1600, 2400, 3867]}
        sizes="(min-width: 768px) 310vw, 830vw"
        loading="lazy"
      />
    </div>
  </div>

  <div id="fusion-shade" class="absolute inset-0 bg-[#08080f] opacity-70"></div>
  <div id="fusion-flash" class="absolute inset-0 bg-[#c7d2fe] opacity-0 mix-blend-soft-light"></div>
  <div
    class="absolute inset-0"
    style="background: linear-gradient(180deg, #08080f 0%, transparent 22%, transparent 70%, #08080f 100%);"
  >
  </div>

  <svg aria-hidden="true" class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.18] mix-blend-overlay">
    <filter id="grain-fusion">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch"></feTurbulence>
      <feColorMatrix type="saturate" values="0"></feColorMatrix>
    </filter>
    <rect width="100%" height="100%" filter="url(#grain-fusion)"></rect>
  </svg>

  <!-- La señal, sobre la zona oscura inferior -->
  <div class="absolute inset-x-0 bottom-[14%] h-[20svh] md:h-[24svh]" aria-hidden="true">
    <svg id="fusion-wave" class="h-full w-full overflow-visible" viewBox="0 0 1000 300" preserveAspectRatio="none">
      <path class="fill-none stroke-white/20" stroke-width="1" vector-effect="non-scaling-stroke"></path>
      <path class="fill-none stroke-[#a5b4fc]/50" stroke-width="1" vector-effect="non-scaling-stroke"></path>
      <path
        class="fill-none stroke-white"
        stroke-width="1.5"
        vector-effect="non-scaling-stroke"
        style="filter: drop-shadow(0 0 6px rgba(129,140,248,0.9));"></path>
    </svg>
  </div>

  <!-- Pregunta y respuesta: sin música pregunta; con música responde la firma -->
  <p
    id="fusion-hint"
    class="absolute bottom-[6%] left-6 right-24 text-[10px] font-bold uppercase tracking-[0.3em] text-white/50 transition-opacity duration-500 md:inset-x-0 md:text-center"
  >
    ¿Qué ves cuando escuchás? ↘
  </p>
</section>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  const svg = document.getElementById('fusion-wave')
  const paths = [...(svg?.querySelectorAll('path') ?? [])]
  const beatEl = document.getElementById('fusion-beat')
  const flash = document.getElementById('fusion-flash')
  const hint = document.getElementById('fusion-hint')
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches

  const POINTS = 140
  const BEAT = 60 / 142 // segundos por negra a 142 BPM
  const layers = [
    { f1: 0.011, f2: 0.034, s1: 1.1, s2: 0.7, k: 0.55 },
    { f1: 0.017, f2: 0.026, s1: 1.6, s2: 1.2, k: 0.8 },
    { f1: 0.014, f2: 0.041, s1: 2.2, s2: 1.5, k: 1 },
  ]
  const env = (x: number) => Math.pow(Math.sin((Math.PI * x) / 1000), 1.5)

  const draw = (t: number, amp: number) => {
    paths.forEach((path, i) => {
      const l = layers[i]
      let d = ''
      for (let p = 0; p <= POINTS; p++) {
        const x = (p / POINTS) * 1000
        const y =
          150 + amp * l.k * env(x) * (0.6 * Math.sin(x * l.f1 + t * l.s1 + i) + 0.4 * Math.sin(x * l.f2 - t * l.s2))
        d += `${p ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`
      }
      path.setAttribute('d', d)
    })
  }

  if (reduced) {
    gsap.set('#fusion-sharp', { opacity: 1 })
    gsap.set('#fusion-shade', { opacity: 0.3 })
    draw(0, 30)
  } else {
    gsap.registerPlugin(ScrollTrigger)

    // A: la mirada se acerca y entra en foco; al irse, se desenfoca
    gsap
      .timeline({
        defaults: { ease: 'none' },
        scrollTrigger: { trigger: '#fusion', start: 'top bottom', end: 'bottom top', scrub: 1 },
      })
      .fromTo('#fusion-layers', { scale: 1.18 }, { scale: 1, duration: 0.5 }, 0)
      .fromTo('#fusion-sharp', { opacity: 0 }, { opacity: 1, duration: 0.4 }, 0.1)
      .fromTo('#fusion-shade', { opacity: 0.8 }, { opacity: 0.25, duration: 0.4 }, 0.1)
      .to('#fusion-sharp', { opacity: 0.2, duration: 0.35 }, 0.65)
      .to('#fusion-shade', { opacity: 0.7, duration: 0.35 }, 0.65)

    // B: la señal reacciona al scroll; con música, kick a 142 BPM. Puente: la mirada late con el kick.
    let amp = 6
    let lastY = scrollY
    let raf = 0
    let wasPlaying = false
    const setHint = (playing: boolean) => {
      if (!hint || playing === wasPlaying) return
      wasPlaying = playing
      hint.style.opacity = '0'
      setTimeout(() => {
        hint.textContent = playing ? 'Feel what I hear.' : '¿Qué ves cuando escuchás? ↘'
        hint.style.opacity = ''
      }, 500)
    }
    const isPlaying = () => !!document.querySelector('#audio-player .is-spinning')

    const tick = (ms: number) => {
      const t = ms / 1000
      const velocity = Math.abs(scrollY - lastY)
      lastY = scrollY
      const playing = isPlaying()
      const pulse = playing ? Math.exp(-(t % BEAT) / 0.09) : 0 // 1 en el golpe, decae rápido
      const target = 6 + Math.min(80, velocity * 2.5) + (playing ? 22 : 0) + pulse * 70
      amp += (target - amp) * (pulse > 0.6 ? 0.5 : 0.12)
      draw(t, amp)
      if (beatEl) beatEl.style.transform = `scale(${1 + pulse * 0.012})`
      if (flash) flash.style.opacity = String(pulse * 0.12)
      setHint(playing)
      raf = requestAnimationFrame(tick)
    }

    if (svg) {
      new IntersectionObserver(([e]) => {
        cancelAnimationFrame(raf)
        if (e.isIntersecting) {
          lastY = scrollY
          raf = requestAnimationFrame(tick)
        }
      }).observe(svg)
      draw(0, amp)
    }
  }
</script>
