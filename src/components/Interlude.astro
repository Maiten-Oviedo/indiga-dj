---
import { Image } from 'astro:assets'
import portraitEyes from '../assets/img/portrait-eyes.jpg'
---

<!-- "Los ojos se abren": Animations.astro pinea la sección y anima el clip-path de #eyes -->
<section id="interlude-section" class="relative h-svh overflow-hidden">
  <div id="eyes" class="absolute inset-0">
    <Image
      src={portraitEyes}
      alt="Mirada de INDIGA"
      class="h-full w-full object-contain"
      widths={[800, 1600, 2400]}
      sizes="100vw"
      loading="lazy"
    />
  </div>
</section>
