---
import { Image } from 'astro:assets'
import live01 from '../assets/img/live-01.jpg'
import live03 from '../assets/img/live-03.jpg'
import live04 from '../assets/img/live-04.jpg'
import live05 from '../assets/img/live-05.jpg'
import live06 from '../assets/img/live-06.jpg'
import live07 from '../assets/img/live-07.jpg'

const gallery = [live01, live03, live04, live05, live06, live07]
---

<section id="livegrid-section" class="relative overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <Image
      id="livegrid-bg"
      src={live06}
      alt=""
      class="absolute -top-[15%] h-[130%] w-full object-cover blur-[2px]"
      widths={[1200, 1920, 2400]}
      sizes="100vw"
      loading="lazy"
    />
    <div
      class="absolute inset-0"
      style="background: linear-gradient(180deg, rgba(8,8,15,0.88) 0%, rgba(8,8,15,0.72) 40%, rgba(8,8,15,0.92) 100%);"
    >
    </div>
  </div>

  <svg
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.15] mix-blend-overlay"
  >
    <filter id="grain-livegrid">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.85"
        numOctaves="2"
        stitchTiles="stitch"></feTurbulence>
      <feColorMatrix type="saturate" values="0"></feColorMatrix>
    </filter>
    <rect width="100%" height="100%" filter="url(#grain-livegrid)"></rect>
  </svg>

  <div class="relative px-6 py-24 md:px-12 md:py-32 lg:py-40">
    <p
      data-lg
      class="mb-4 text-xs font-bold uppercase tracking-[0.3em] text-white/70"
    >
      03 — En cabina
    </p>
    <h2
      data-lg
      class="mb-16 font-serif text-4xl leading-tight md:mb-24 md:text-5xl lg:text-6xl"
    >
      La pista<br />como lenguaje.
    </h2>

    <div class="relative">
      <span
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-8 -right-4 select-none font-serif font-bold leading-[0.8] text-white/[0.05] md:-bottom-12 md:-right-8"
        style="font-size: clamp(10rem, 38vw, 42rem);"
      >
        03
      </span>

      <div class="photo-grid relative z-10 grid grid-cols-12 gap-3 md:gap-5">
        <figure class="col-span-6 md:col-span-4">
          <div
            class="relative aspect-[4/5] overflow-hidden shadow-2xl ring-1 ring-white/10 md:-rotate-[1.5deg]"
          >
            <Image
              src={gallery[0]}
              alt="INDIGA en cabina"
              class="h-full w-full object-cover"
              widths={[300, 600, 900]}
              sizes="(min-width: 768px) 30vw, 50vw"
              loading="lazy"
            />
          </div>
        </figure>

        <figure class="col-span-6 md:col-span-4 md:mt-16">
          <div
            class="relative aspect-[4/5] overflow-hidden shadow-2xl ring-1 ring-white/10"
          >
            <Image
              src={gallery[1]}
              alt=""
              class="h-full w-full object-cover"
              widths={[300, 600, 900]}
              sizes="(min-width: 768px) 30vw, 50vw"
              loading="lazy"
            />
          </div>
        </figure>

        <figure class="col-span-6 md:col-span-4 md:-mt-8">
          <div
            class="relative aspect-[4/5] overflow-hidden shadow-2xl ring-1 ring-white/10 md:rotate-[1.5deg]"
          >
            <Image
              src={gallery[2]}
              alt=""
              class="h-full w-full object-cover"
              widths={[300, 600, 900]}
              sizes="(min-width: 768px) 30vw, 50vw"
              loading="lazy"
            />
          </div>
        </figure>

        <figure class="col-span-6 md:col-span-5 md:col-start-1 md:mt-4">
          <div
            class="relative aspect-[3/2] overflow-hidden shadow-2xl ring-1 ring-white/10"
          >
            <Image
              src={gallery[3]}
              alt=""
              class="h-full w-full object-cover"
              widths={[400, 800, 1200]}
              sizes="(min-width: 768px) 42vw, 50vw"
              loading="lazy"
            />
          </div>
        </figure>

        <figure class="col-span-6 md:col-span-3 md:mt-16">
          <div
            class="relative aspect-[4/5] overflow-hidden shadow-2xl ring-1 ring-white/10 md:-rotate-[1deg]"
          >
            <Image
              src={gallery[4]}
              alt="Cabina — vista general"
              class="h-full w-full object-cover"
              widths={[300, 600, 900]}
              sizes="(min-width: 768px) 25vw, 50vw"
              loading="lazy"
            />
          </div>
        </figure>

        <figure class="col-span-6 md:col-span-4 md:mt-8">
          <div
            class="relative aspect-[4/5] overflow-hidden shadow-2xl ring-1 ring-white/10 md:rotate-[1deg]"
          >
            <Image
              src={gallery[5]}
              alt=""
              class="h-full w-full object-cover"
              widths={[300, 600, 900]}
              sizes="(min-width: 768px) 30vw, 50vw"
              loading="lazy"
            />
          </div>
        </figure>

      </div>
    </div>
  </div>
</section>

<style>
  .photo-grid figure {
    cursor: pointer;
  }
  /* reset explícito: nada cambia en las demás fotos */
  .photo-grid figure > div img {
    filter: brightness(1);
    transition: transform 0.7s ease;
  }
  .photo-grid figure:hover > div img {
    transform: scale(1.04);
  }
</style>
