---
const email = 'psymania.ar@gmail.com';
const instagram = 'https://www.instagram.com/indiga_____/';
const soundcloud = 'https://on.soundcloud.com/OwR1GW94sVT65zVWKd';
const showPdfDownload = false;
---

<section class="relative overflow-hidden px-6 py-24 md:px-12 md:py-32 lg:py-40">
  <img
    src="/img/star-01.png"
    alt=""
    aria-hidden="true"
    loading="lazy"
    class="pointer-events-none absolute -left-8 top-16 -z-0 w-48 brightness-0 invert opacity-[0.07] md:-left-12 md:top-24 md:w-72"
  />

  <p
    class="relative text-xs font-bold uppercase tracking-[0.3em] text-white/50"
  >
    07 — Contacto
  </p>
  <h2
    class="relative mt-4 font-serif text-4xl md:text-5xl lg:text-6xl leading-tight"
  >
    Bookings<br />y enlaces.
  </h2>

  <div
    class="relative mt-16 grid grid-cols-1 gap-16 border-t border-white/10 pt-16 md:mt-24 md:grid-cols-2 md:gap-16"
  >
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.3em] text-white/40">
        Bookings
      </p>
      <a
        href={`mailto:${email}`}
        class="mt-6 inline-block break-all font-serif text-2xl md:text-3xl underline-offset-8 hover:underline"
      >
        {email}
      </a>
    </div>

    <div>
      <p class="text-xs font-bold uppercase tracking-[0.3em] text-white/40">
        Redes
      </p>
      <ul class="mt-6 space-y-4">
        <li>
          <a
            href={instagram}
            target="_blank"
            rel="noopener"
            class="group inline-flex items-baseline gap-4 font-serif text-2xl md:text-3xl underline-offset-8 hover:underline"
          >
            Instagram
            <span
              class="font-sans text-xs uppercase tracking-[0.2em] text-white/40 transition-colors group-hover:text-white/80"
            >
              @indiga_____
            </span>
          </a>
        </li>
        <li>
          <a
            href={soundcloud}
            target="_blank"
            rel="noopener"
            class="group inline-flex items-baseline gap-4 font-serif text-2xl md:text-3xl underline-offset-8 hover:underline"
          >
            SoundCloud
            <span
              class="font-sans text-xs uppercase tracking-[0.2em] text-white/40 transition-colors group-hover:text-white/80"
            >
              Escuchar
            </span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  {
    showPdfDownload && (
      <a
        href="/presskit/indiga-presskit.pdf"
        download="indiga-presskit.pdf"
        class="group relative mt-20 flex items-center justify-between gap-6 border-y border-white/20 py-8 transition-colors hover:border-white/60 md:mt-24 md:py-10"
        aria-label="Descargar presskit completo en PDF"
      >
        <span class="flex flex-col gap-1">
          <span class="text-xs font-bold uppercase tracking-[0.3em] text-white/40">
            Presskit completo
          </span>
          <span class="font-serif text-2xl md:text-3xl lg:text-4xl leading-tight">
            Descargar PDF
          </span>
        </span>
        <span class="flex h-14 w-14 items-center justify-center rounded-full border border-white/30 transition-all group-hover:h-16 group-hover:w-16 group-hover:border-white group-hover:bg-white md:h-16 md:w-16 md:group-hover:h-20 md:group-hover:w-20">
          <svg
            class="h-6 w-6 text-white transition-colors group-hover:text-[var(--color-bg)] md:h-7 md:w-7"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
            />
          </svg>
        </span>
      </a>
    )
  }
</section>
