<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';

  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  if (!prefersReducedMotion) {
    gsap.registerPlugin(ScrollTrigger);

    // Scroll inercial: Lenis maneja el scroll y GSAP le marca el ritmo
    const lenis = new Lenis();
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => lenis.raf(time * 1000));
    gsap.ticker.lagSmoothing(0);

    // Entrada: estos elementos ya arrancan ocultos por CSS (.motion en global.css),
    // así que se animan con fromTo hacia opacity 1 — sin flash antes de que cargue el JS
    gsap.fromTo(
      '[data-anim="hero"]',
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 1.2, stagger: 0.25, ease: 'power3.out', delay: 0.3 }
    );
    gsap.fromTo(
      '#hero-cutout',
      { opacity: 0, y: '8%' },
      { opacity: 1, y: 0, duration: 1.6, delay: 0.5, ease: 'power3.out' }
    );
    gsap.fromTo(
      '#audio-player',
      { opacity: 0, y: 60 },
      { opacity: 1, y: 0, duration: 1.4, delay: 1.3, ease: 'power3.out' }
    );

    const heroSection = document.getElementById('hero-section');
    const heroBg = document.getElementById('hero-bg');
    const mm = gsap.matchMedia();

    // Hero desktop: pin + capas a distinta velocidad (fondo se aleja, Cele avanza)
    mm.add('(min-width: 768px)', () => {
      gsap
        .timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            trigger: heroSection,
            start: 'top top',
            end: '+=80%',
            pin: true,
            refreshPriority: 1, // los pins se recalculan antes que el resto
            scrub: 1,
          },
        })
        .to(heroBg, { scale: 1.12, opacity: 0.08 }, 0)
        .to('#hero-word', { scale: 0.86, yPercent: -6, opacity: 0.35 }, 0)
        .to('#hero-cutout img', { scale: 1.1, yPercent: -4, transformOrigin: '50% 100%' }, 0)
        .to('#hero-section header', { opacity: 0, yPercent: -40 }, 0);
    });

    // Hero mobile: parallax simple
    mm.add('(max-width: 767px)', () => {
      gsap.to(heroBg, {
        y: '10%',
        ease: 'none',
        scrollTrigger: { trigger: heroSection, start: 'top top', end: 'bottom top', scrub: 1.2 },
      });
    });

    // Títulos: cada línea (separada por <br>) sube desde una máscara
    document.querySelectorAll<HTMLElement>('section h2').forEach((h2) => {
      h2.innerHTML = h2.innerHTML
        .split(/<br\s*\/?>/i)
        .map((line) => `<span class="mask-line"><span>${line.trim()}</span></span>`)
        .join('');
      gsap.from(h2.querySelectorAll('.mask-line > span'), {
        yPercent: 110,
        duration: 1.1,
        stagger: 0.12,
        ease: 'power4.out',
        scrollTrigger: { trigger: h2, start: 'top 85%', once: true },
      });
    });

    // Venues: cada nombre sube desde su máscara, en cascada
    document.querySelectorAll('[data-venues]').forEach((list) => {
      gsap.from(list.querySelectorAll('.venue-item > span'), {
        yPercent: 105,
        duration: 0.9,
        stagger: 0.07,
        ease: 'power3.out',
        scrollTrigger: { trigger: list, start: 'top 85%', once: true },
      });
    });

    // Texto que se "enciende" palabra por palabra con el scroll
    document.querySelectorAll('[data-reveal]').forEach((block) => {
      gsap.fromTo(
        block.querySelectorAll('.reveal-word'),
        { opacity: 0.15 },
        {
          opacity: 1,
          stagger: 0.1,
          ease: 'none',
          scrollTrigger: { trigger: block, start: 'top 80%', end: 'bottom 50%', scrub: true },
        }
      );
    });

    // LiveGrid: parallax fondo + entrada escalonada por figura
    const livegridSection = document.getElementById('livegrid-section');
    const livegridBg = document.getElementById('livegrid-bg');

    if (livegridSection && livegridBg) {
      gsap.to(livegridBg, {
        y: '8%',
        ease: 'none',
        scrollTrigger: {
          trigger: livegridSection,
          start: 'top bottom',
          end: 'bottom top',
          scrub: 2.5,
        },
      });
    }

    // LiveGrid desktop: pin + la galería avanza de costado mientras bajás
    mm.add('(min-width: 768px)', () => {
      const track = livegridSection?.querySelector<HTMLElement>('.photo-grid');
      if (!livegridSection || !track) return;
      const distance = () => track.scrollWidth - (innerWidth - 96); // 96 = px-12 a cada lado
      gsap.to(track, {
        x: () => -distance(),
        ease: 'none',
        scrollTrigger: {
          trigger: livegridSection,
          start: 'top top',
          end: () => `+=${distance()}`,
          pin: true,
          refreshPriority: 1, // los pins se recalculan antes que el resto
          scrub: 1,
          invalidateOnRefresh: true,
        },
      });
    });

    if (livegridSection) {
      const els = livegridSection.querySelectorAll('[data-lg], figure');
      gsap.from(els, {
        opacity: 0,
        y: 50,
        duration: 0.9,
        stagger: 0.1,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: livegridSection,
          start: 'top 70%',
          once: true,
        },
      });
    }

    // Interlude: una señal baja desde Camino, toca la línea de ojos, se vuelve ranura
    // y la mirada se abre como un párpado. La foto (21:9, object-contain) queda como
    // franja; los ojos están al 75% de su alto.
    const EYE_LINE = 0.75;
    const LINE_REACH = 120; // px que la señal asoma dentro de Camino
    const interlude = document.getElementById('interlude-section')!;
    const band = () => {
      // alto de la franja en % de la sección (en mobile la sección mide medio viewport)
      const h = Math.min(1, (interlude.offsetWidth * 9) / 21 / interlude.offsetHeight);
      const top = ((1 - h) / 2) * 100;
      return { top, eye: top + EYE_LINE * h * 100 };
    };
    const slit = (side: number) =>
      `inset(${band().eye - 0.4}% ${side}% ${100 - band().eye - 0.4}% ${side}%)`;

    // 1) La señal se dibuja hacia abajo mientras la sección entra
    gsap.fromTo(
      '#eyes-line',
      {
        opacity: 1,
        scaleY: 0,
        transformOrigin: '50% 0%',
        top: -LINE_REACH,
        height: () => LINE_REACH + (interlude.offsetHeight * band().eye) / 100,
      },
      {
        scaleY: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: '#interlude-section',
          start: `top bottom+=${LINE_REACH}`,
          end: 'center center',
          scrub: 1,
          invalidateOnRefresh: true,
        },
      }
    );

    // 2) Pin: la señal se abre en ranura horizontal y después la mirada se abre
    gsap
      .timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: '#interlude-section',
          start: 'center center', // la sección mide menos que el viewport: pinea antes
          end: '+=100%',
          pin: true,
          refreshPriority: 1, // los pins se recalculan antes que el resto
          scrub: 1,
          invalidateOnRefresh: true,
        },
      })
      .fromTo('#eyes', { clipPath: () => slit(50) }, { clipPath: () => slit(35), duration: 0.12 }, 0)
      .to('#eyes-line', { opacity: 0, duration: 0.1 }, 0.02)
      // fromTo explícito: el navegador simplifica inset(a b c b) a 3 valores y un .to() desparejaría los números
      .fromTo(
        '#eyes',
        { clipPath: () => slit(35) },
        {
          clipPath: () => `inset(${band().top}% 0% ${band().top}% 0%)`,
          duration: 0.88,
          immediateRender: false,
        },
        0.12
      )
      .fromTo(
        '#eyes img',
        { scale: 1.2, transformOrigin: () => `50% ${band().eye}%` },
        { scale: 1, duration: 1 },
        0
      );

    // Setup: parallax del fondo, barrido de la ficha técnica y equipo en cascada
    gsap.to('#setup-bg', {
      y: '8%',
      ease: 'none',
      scrollTrigger: { trigger: '#setup-section', start: 'top bottom', end: 'bottom top', scrub: 2.5 },
    });
    gsap.fromTo(
      '[data-wipe]',
      { clipPath: 'inset(0% 100% 0% 0%)' },
      {
        clipPath: 'inset(0% 0% 0% 0%)',
        ease: 'none',
        scrollTrigger: { trigger: '[data-wipe]', start: 'top 85%', end: 'top 35%', scrub: 1 },
      }
    );
    document.querySelectorAll('[data-cascade]').forEach((list) => {
      gsap.from(list.children, {
        opacity: 0,
        y: 30,
        duration: 0.8,
        stagger: 0.12,
        ease: 'power3.out',
        scrollTrigger: { trigger: list, start: 'top 85%', once: true },
      });
    });

    // Contacto: el fondo se aleja hasta el final y el wordmark vuelve letra por letra
    gsap.fromTo(
      '#contact-bg',
      { scale: 1.15 },
      {
        scale: 1,
        ease: 'none',
        scrollTrigger: { trigger: '#contact-section', start: 'top bottom', end: 'bottom bottom', scrub: true },
      }
    );
    gsap.from('#closing-word span', {
      yPercent: 110,
      duration: 1.2,
      stagger: 0.07,
      ease: 'power4.out',
      scrollTrigger: { trigger: '#closing-word', start: 'top 95%', once: true },
    });

    const sections = Array.from(document.querySelectorAll('section'))
      .slice(1)
      .filter((s) => s.id !== 'livegrid-section' && s.id !== 'interlude-section');
    sections.forEach((section) => {
      gsap.set(section, { opacity: 0, y: 40 });
      gsap.to(section, {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: section,
          start: 'top 85%',
          once: true,
        },
      });
    });
  }
</script>
