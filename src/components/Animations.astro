<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  if (!prefersReducedMotion) {
    gsap.registerPlugin(ScrollTrigger);

    const heroElements = document.querySelectorAll('[data-anim="hero"]');
    if (heroElements.length) {
      gsap.from(heroElements, {
        opacity: 0,
        y: 30,
        duration: 1.2,
        stagger: 0.25,
        ease: 'power3.out',
        delay: 0.3,
      });
    }

    const audioPlayer = document.getElementById('audio-player');
    if (audioPlayer) {
      gsap.from(audioPlayer, {
        opacity: 0,
        y: 60,
        duration: 1.4,
        delay: 1.3,
        ease: 'power3.out',
      });
    }

    const heroSection = document.querySelector('section');
    const heroBg = document.getElementById('hero-bg');

    if (heroSection && heroBg) {
      gsap.to(heroBg, {
        y: '10%',
        ease: 'none',
        scrollTrigger: {
          trigger: heroSection,
          start: 'top top',
          end: 'bottom top',
          scrub: 1.2,
        },
      });
    }

    // LiveGrid: parallax fondo + entrada escalonada por figura
    const livegridSection = document.getElementById('livegrid-section');
    const livegridBg = document.getElementById('livegrid-bg');

    if (livegridSection && livegridBg) {
      gsap.to(livegridBg, {
        y: '8%',
        ease: 'none',
        scrollTrigger: {
          trigger: livegridSection,
          start: 'top bottom',
          end: 'bottom top',
          scrub: 2.5,
        },
      });
    }

    if (livegridSection) {
      const els = livegridSection.querySelectorAll('[data-lg], figure');
      gsap.from(els, {
        opacity: 0,
        y: 50,
        duration: 0.9,
        stagger: 0.1,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: livegridSection,
          start: 'top 70%',
          once: true,
        },
      });
    }

    const sections = Array.from(document.querySelectorAll('section'))
      .slice(1)
      .filter((s) => s.id !== 'livegrid-section');
    sections.forEach((section) => {
      gsap.set(section, { opacity: 0, y: 40 });
      gsap.to(section, {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: section,
          start: 'top 85%',
          once: true,
        },
      });
    });
  }
</script>
